{
  "manifest_version": 3,
  "name": "Better CaptionKeep",
  "version": "5.3.0",
  "description": "Capture live captions and privately import verified Microsoft Teams transcripts for local review and export.",
  "homepage_url": "https://github.com/Mr-GraphnStaff/better-captionkeep",
  "icons": {
    "16": "icons/scribble-16.png",
    "32": "icons/scribble-32.png",
    "48": "icons/scribble-48.png",
    "128": "icons/scribble-128.png"
  },
  "permissions": [
    "downloads",
    "activeTab",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "identity"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "storage": {
    "managed_schema": "managed-schema.json"
  },
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://meet.google.com/*",
    "https://app.zoom.us/*",
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/scribble-16.png",
      "32": "icons/scribble-32.png",
      "48": "icons/scribble-48.png",
      "128": "icons/scribble-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Better CaptionKeep \u2014 by Se\u00f1or Farris"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": [
        "providerRegistry.js",
        "configuration.js",
        "transcriptInsights.js",
        "teamsCaptionBuffer.js",
        "content_script.js"
      ]
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "providerRegistry.js",
        "configuration.js",
        "captureCoordinator.js",
        "transcriptInsights.js",
        "googleMeetProvider.js",
        "googleMeetContentScript.js"
      ]
    },
    {
      "matches": [
        "https://app.zoom.us/wc/*"
      ],
      "all_frames": true,
      "js": [
        "providerRegistry.js",
        "configuration.js",
        "captureCoordinator.js",
        "transcriptInsights.js",
        "zoomProvider.js",
        "zoomContentScript.js"
      ]
    }
  ],
  "author": "Se\u00f1or Farris"
}
