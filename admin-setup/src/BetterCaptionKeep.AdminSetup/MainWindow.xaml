<Window x:Class="BetterCaptionKeep.AdminSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework"
        Title="Better CaptionKeep Administrator Setup"
        Width="1080" Height="760" MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip"
        Icon="Assets/daf-tech-sphere.png"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="Transparent" Foreground="#142523">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="8" CornerRadius="20" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Border x:Name="WindowFrame" Background="#F4F8F7" BorderBrush="#5AAFA7" BorderThickness="1"
          SnapsToDevicePixels="True" ClipToBounds="True">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Margin" Value="12" />
        <Setter Property="CornerRadius" Value="20" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.28" Color="#062B28" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#052E2B" Padding="16,0,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="Assets/daf-tech-sphere.png" Width="22" Height="22" Margin="0,0,9,0" />
            <TextBlock Text="Better CaptionKeep Administrator Setup" Foreground="#E8F7F5" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource WindowCaptionButtonStyle}" Content="—"
                    ToolTip="Minimize" AutomationProperties.Name="Minimize window"
                    Command="{x:Static system:SystemCommands.MinimizeWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="□" ToolTip="Maximize" AutomationProperties.Name="Maximize window"
                    Command="{x:Static system:SystemCommands.MaximizeWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource WindowCaptionButtonStyle}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="❐" ToolTip="Restore" AutomationProperties.Name="Restore window"
                    Command="{x:Static system:SystemCommands.RestoreWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource WindowCaptionButtonStyle}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Style="{StaticResource WindowCloseButtonStyle}" Content="×"
                    ToolTip="Close" AutomationProperties.Name="Close window"
                    Command="{x:Static system:SystemCommands.CloseWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
          </StackPanel>
        </Grid>
      </Border>

    <Border Grid.Row="1" Background="#073F3B" BorderBrush="#32B8AA" BorderThickness="0,0,0,2" Padding="28,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="58" Height="58" CornerRadius="29" Background="#0B2927" BorderBrush="#56D1C4" BorderThickness="1" Margin="0,0,16,0">
          <Image Source="Assets/daf-tech-sphere.png" Width="52" Height="52" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Better CaptionKeep" Foreground="White" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="A DAF-TECH product · Microsoft 365 and Intune administrator setup" Foreground="#BFE8E3" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="2" Background="#0E5751" BorderBrush="#43BEB2" BorderThickness="1" CornerRadius="18" Padding="14,7" VerticalAlignment="Center">
          <TextBlock x:Name="EnvironmentBadgeText" Text="DEVELOPMENT  ·  NO-WRITE PREVIEW" Foreground="White" FontSize="12" FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#E8F2F0" BorderBrush="#B8CECA" BorderThickness="0,0,1,0" Padding="28,32">
        <StackPanel>
          <TextBlock Text="SETUP PROGRESS" FontSize="11" FontWeight="SemiBold" Foreground="#496D68" Margin="0,0,0,18" />
          <TextBlock x:Name="StepWelcome" Text="1  Welcome" FontSize="15" Margin="0,0,0,18" />
          <TextBlock x:Name="StepAdministrator" Text="2  Administrator" FontSize="15" Margin="0,0,0,18" />
          <TextBlock x:Name="StepDeployment" Text="3  Deployment" FontSize="15" Margin="0,0,0,18" />
          <TextBlock x:Name="StepReview" Text="4  Review" FontSize="15" Margin="0,0,0,18" />
          <TextBlock x:Name="StepVerify" Text="5  Verify" FontSize="15" Margin="0,0,0,18" />
          <Separator Margin="0,12,0,18" />
          <TextBlock Text="Your controls" FontWeight="SemiBold" />
          <TextBlock x:Name="YourControlsText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#496D68"
                     Text="Nothing is deployed until an administrator reviews and approves an exact plan. This preview never deploys." />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Column="1" Background="#F7FAF9" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="44,36,44,28">
          <StackPanel x:Name="WelcomePanel">
            <TextBlock x:Name="WelcomeHeading" Text="Set up Better CaptionKeep for your organization" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Focusable="True" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="WelcomeDescription" Margin="0,12,0,26" FontSize="16" TextWrapping="Wrap" MaxWidth="690" HorizontalAlignment="Left"
                       Text="Connect Microsoft 365, select the browsers and existing group you manage, review the exact plan, and create or observe the customer-owned Entra application registration. Intune deployment remains disabled in this build." />
            <Border Style="{StaticResource SetupCardStyle}" Margin="0,0,0,22" Padding="22">
              <StackPanel>
                <TextBlock Text="Connect your organization" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Margin="0,9,0,18" TextWrapping="Wrap" Text="Sign in with Microsoft, choose a pilot group and browsers, then approve the changes. Setup creates the Microsoft 365 connection and deploys the browser settings through Intune." />
                <Button x:Name="StartEnterpriseSetupButton" Style="{StaticResource PrimaryButtonStyle}"
                        Content="Set up Microsoft 365" HorizontalAlignment="Left" Click="StartEnterpriseSetupButton_Click" />
                <TextBlock x:Name="EnterpriseLaunchStatus" Margin="0,14,0,0" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </Border>
            <Border x:Name="ExternalOperationPanel" Visibility="Collapsed" Margin="0,0,0,22" Padding="22"
                    Background="#E5F4F1" BorderBrush="#087D73" BorderThickness="1" CornerRadius="14">
              <StackPanel>
                <TextBlock x:Name="ExternalOperationHeading" Text="Preparing Microsoft 365 setup" FontSize="20"
                           FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="ExternalOperationDescription" Margin="0,9,0,16" TextWrapping="Wrap" FontSize="15"
                           Text="Setup is preparing the next step. Keep this window open; you can bring Microsoft sign-in forward when it is ready."
                           AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="ExternalOperationProgress" Height="7" IsIndeterminate="True"
                             Foreground="#087D73" Background="#C6E6DF"
                             AutomationProperties.Name="Microsoft 365 setup is working; time remaining is unknown" />
                <Button x:Name="ShowSigninButton" Visibility="Collapsed" Margin="0,18,0,0"
                        Style="{StaticResource PrimaryButtonStyle}" Content="Show Microsoft sign-in"
                        HorizontalAlignment="Left" Click="ShowSignin_Click" />
              </StackPanel>
            </Border>
            <Expander x:Name="RecoveryOptionsPanel" Header="Check or continue an earlier setup" Margin="0,0,0,18">
              <StackPanel Margin="0,12,0,0">
                <TextBlock TextWrapping="Wrap" Text="Use the saved setup receipt to check a deployment or continue after an interruption. Do not start another deployment to retry an uncertain result." />
                <WrapPanel Margin="0,12,0,0">
                  <Button x:Name="EnterpriseStatusButton" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,10"
                          Content="Check deployment status" Click="EnterpriseStatusButton_Click" />
                  <Button x:Name="EnterpriseContinueButton" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,10"
                          Content="Continue saved setup" Click="EnterpriseContinueButton_Click" />
                </WrapPanel>
              </StackPanel>
            </Expander>
            <Expander x:Name="AdvancedOptionsPanel" Header="Demo and advanced options" Margin="0,0,0,22">
              <StackPanel Margin="0,12,0,0">
              <Border Style="{StaticResource SetupCardStyle}" Margin="0,0,0,12" Padding="20">
                <StackPanel>
                  <TextBlock Text="Guided demo" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock Margin="0,7,0,14" TextWrapping="Wrap" Text="Explore every step with obvious Contoso example data. No Microsoft sign-in, network request, receipt file, or organization change occurs." />
                  <Button x:Name="RunGuidedDemoButton" Style="{StaticResource SecondaryButtonStyle}"
                          Content="Run guided demo" HorizontalAlignment="Left" Click="RunGuidedDemoButton_Click" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SetupCardStyle}" Margin="0,0,0,12" Padding="20">
                <StackPanel>
                  <TextBlock Text="Development application-registration test" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Margin="0,7,0,14" TextWrapping="Wrap" Text="Check this PC for the reviewed administrator bootstrap before Microsoft sign-in or any organization operation becomes available." />
                  <Button x:Name="StartRealSetupButton" Style="{StaticResource SecondaryButtonStyle}"
                          Content="Open development test" HorizontalAlignment="Left" Click="StartRealSetupButton_Click" />
                </StackPanel>
              </Border>
            <Border Style="{StaticResource SetupCardStyle}" Margin="0,0,0,22" Padding="20">
                <StackPanel>
                  <TextBlock Text="Create the app registration yourself" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock Margin="0,7,20,0" TextWrapping="Wrap" Text="Use Microsoft Entra directly and enter the resulting tenant and application IDs. This path never requests Application.ReadWrite.All for Better CaptionKeep." />
                <Button x:Name="StartManualSetupButton" Style="{StaticResource SecondaryButtonStyle}" Margin="0,14,0,0"
                        Content="Use manual setup" HorizontalAlignment="Left" Click="StartManualSetupButton_Click" />
                </StackPanel>
            </Border>
              </StackPanel>
            </Expander>
            <WrapPanel Margin="0,0,0,14">
              <Border Style="{StaticResource SetupCardStyle}" Width="210" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Microsoft sign-in" FontWeight="SemiBold" FontSize="15"/><TextBlock Margin="0,7,0,0" TextWrapping="Wrap" FontSize="13" Text="Use Microsoft’s account chooser, MFA, Conditional Access, and PIM."/></StackPanel>
              </Border>
              <Border Style="{StaticResource SetupCardStyle}" Width="210" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Your tenant" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="TenantCardDescription" Margin="0,7,0,0" TextWrapping="Wrap" FontSize="13" Text="The Entra application and Intune assignment remain customer-owned."/></StackPanel>
              </Border>
              <Border Style="{StaticResource SetupCardStyle}" Width="210" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Verified result" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="VerifiedResultDescription" Margin="0,7,0,0" TextWrapping="Wrap" FontSize="13" Text="Finish with endpoint checks and a downloadable deployment receipt."/></StackPanel>
              </Border>
            </WrapPanel>
            <Border x:Name="PreviewModeBanner" BorderBrush="#2B8C83" BorderThickness="1" CornerRadius="12" Padding="16" Background="#142B2929">
              <StackPanel>
                <TextBlock Text="Read-only Development preview" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Text="NO-WRITE PREVIEW — synthetic data; Microsoft sign-in and deployment are disabled." />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PrerequisitePanel" Visibility="Collapsed">
            <TextBlock x:Name="PrerequisiteHeading" Text="Real setup prerequisites" FontSize="30" FontWeight="SemiBold"
                       TextWrapping="Wrap" Focusable="True" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Margin="0,12,0,24" FontSize="15" TextWrapping="Wrap"
                       Text="Real setup is not configured on this PC. Nothing contacted Microsoft, opened sign-in, wrote a receipt, or changed your organization." />
            <Border Style="{StaticResource SetupCardStyle}" Padding="22">
              <StackPanel>
                <TextBlock Text="Complete this checklist" FontWeight="SemiBold" FontSize="17" />
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="24"
                           Text="1. Install the signed Better CaptionKeep administrator setup package and native host.&#x0a;2. Install the reviewed setup-bootstrap.json beside the application.&#x0a;3. Relaunch setup from the Better CaptionKeep extension." />
                <Border Margin="0,18,0,0" Background="#F2FAF8" BorderBrush="#2B8C83" BorderThickness="1" CornerRadius="8" Padding="14">
                  <TextBlock TextWrapping="Wrap" Text="Safe state: no Microsoft sign-in, network request, local deployment journal, or tenant operation was attempted." />
                </Border>
                <Button x:Name="BackToWelcomeButton" Style="{StaticResource SecondaryButtonStyle}" Margin="0,18,0,0"
                        HorizontalAlignment="Left" Content="Back to experience choice" Click="BackToWelcomeButton_Click" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="AdministratorPanel" Visibility="Collapsed">
            <TextBlock x:Name="AdministratorHeading" Text="Choose the administrator identity" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Focusable="True" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Margin="0,12,0,24" FontSize="15" TextWrapping="Wrap" Text="Use the account authorized to configure Microsoft 365 and Intune. This can be different from the employee account used for transcripts." />
            <Border Style="{StaticResource SetupCardStyle}" Padding="22">
              <StackPanel>
                <TextBlock Text="Microsoft 365 administrator" FontWeight="SemiBold" FontSize="17" />
                <TextBlock Margin="0,6,0,18" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Text="Microsoft handles the password, passkey, MFA, Conditional Access, and PIM. Better CaptionKeep never receives the credential." />
                <TextBlock Text="Administrator email" FontWeight="SemiBold" />
                <TextBlock Margin="0,3,0,6" FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Text="Optional — used only as a Microsoft account-selection hint" />
                <TextBox x:Name="AdministratorEmail" Margin="0,0,0,16" AutomationProperties.Name="Administrator email sign-in hint" />
                <Button x:Name="SignInButton" Style="{StaticResource PrimaryButtonStyle}" Content="Continue with Microsoft" HorizontalAlignment="Left" Click="SignInButton_Click" />
                <TextBlock x:Name="AuthenticationStatus" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </Border>
            <Border Margin="0,16,0,0" BorderBrush="#B48A3A" BorderThickness="1" CornerRadius="8" Padding="14">
              <TextBlock x:Name="AdministratorConsentNote" TextWrapping="Wrap" Text="Production note: Microsoft may request read-only consent before group discovery. Granting consent can create or update a tenant permission grant. This synthetic preview requests nothing." />
            </Border>
          </StackPanel>

          <StackPanel x:Name="ManualSetupPanel" Visibility="Collapsed">
            <TextBlock x:Name="ManualSetupHeading" Text="Create the Entra application manually" FontSize="30" FontWeight="SemiBold"
                       TextWrapping="Wrap" Focusable="True" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Margin="0,12,0,22" FontSize="15" TextWrapping="Wrap"
                       Text="This path avoids temporary broad provisioning permission. Your administrator creates the customer-owned app in Microsoft Entra, then records its IDs here for Better CaptionKeep." />
            <Border Style="{StaticResource SetupCardStyle}" Padding="22">
              <StackPanel>
                <TextBlock Text="1. Create a single-tenant public client application" FontWeight="SemiBold" FontSize="17" />
                <TextBlock Margin="0,7,0,14" TextWrapping="Wrap"
                           Text="Open Microsoft Entra app registrations, create the application in the intended tenant, and add the redirect URI below. Do not create a client secret." />
                <Button Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"
                        Content="Open Microsoft Entra app registrations" Click="OpenEntraAppRegistrationsButton_Click" />
                <TextBlock Margin="0,20,0,6" Text="Redirect URI" FontWeight="SemiBold" />
                <TextBox x:Name="ManualRedirectUri" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         Text="https://pjpibiimicedkckleehljlklmblkacph.chromiumapp.org/microsoft"
                         AutomationProperties.Name="Better CaptionKeep redirect URI" />
                <TextBlock Margin="0,20,0,6" Text="Directory (tenant) ID" FontWeight="SemiBold" />
                <TextBox x:Name="ManualTenantId" AutomationProperties.Name="Directory tenant ID" />
                <TextBlock Margin="0,14,0,6" Text="Application (client) ID" FontWeight="SemiBold" />
                <TextBox x:Name="ManualClientId" AutomationProperties.Name="Application client ID" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,18,0,0" HorizontalAlignment="Left"
                        Content="Validate and save manual configuration" Click="SaveManualConfigurationButton_Click" />
                <TextBlock x:Name="ManualConfigurationStatus" Margin="0,14,0,0" TextWrapping="Wrap"
                           Foreground="#496D68" AutomationProperties.LiveSetting="Polite" />
                <TextBox x:Name="ManualConfigurationPathText" Margin="0,8,0,0" Visibility="Collapsed"
                         IsReadOnly="True" IsReadOnlyCaretVisible="True" AutomationProperties.Name="Manual configuration receipt path" />
              </StackPanel>
            </Border>
            <Border Margin="0,16,0,0" BorderBrush="#B48A3A" BorderThickness="1" CornerRadius="8" Padding="14">
              <TextBlock TextWrapping="Wrap"
                         Text="Saving here validates the identifiers and creates a local, non-secret receipt. It does not grant consent or modify Microsoft Entra. Better CaptionKeep will still verify Microsoft sign-in and the configured application before deployment." />
            </Border>
            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,18,0,0" HorizontalAlignment="Left"
                    Content="Back to setup choices" Click="BackToWelcomeButton_Click" />
          </StackPanel>

          <StackPanel x:Name="DeploymentPanel" Visibility="Collapsed">
            <TextBlock x:Name="DeploymentHeading" Text="Choose the deployment target" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Focusable="True" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Margin="0,12,0,24" FontSize="15" TextWrapping="Wrap" Text="Select the browsers and one existing Intune security group. The wizard never creates or changes a group silently." />
            <TextBlock Text="Browsers" FontWeight="SemiBold" FontSize="16" />
            <Grid Margin="0,10,0,22">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource SetupCardStyle}" Margin="0,0,8,0"><CheckBox x:Name="EdgeChoice" Content="Microsoft Edge" IsChecked="True" FontWeight="SemiBold" /></Border>
              <Border Grid.Column="1" Style="{StaticResource SetupCardStyle}" Margin="8,0,0,0"><CheckBox x:Name="ChromeChoice" Content="Google Chrome" IsChecked="True" FontWeight="SemiBold" /></Border>
            </Grid>
            <TextBlock Text="Existing Intune security group" FontWeight="SemiBold" FontSize="16" />
            <TextBox x:Name="GroupSearch" Margin="0,8,0,8" AutomationProperties.Name="Search existing Intune groups" TextChanged="GroupSearch_TextChanged" />
            <ListBox x:Name="GroupResults" MinHeight="96" MaxHeight="210" AutomationProperties.Name="Existing Intune group results">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="8">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,3,0,0"><Run Text="{Binding GroupType}"/><Run Text=" · Object "/><Run Text="{Binding ObjectId}"/></TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <StackPanel x:Name="ReviewPanel" Visibility="Collapsed">
            <TextBlock x:Name="ReviewHeading" Text="Review the organization plan" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Focusable="True" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Margin="0,12,0,22" FontSize="15" TextWrapping="Wrap" Text="Check the organization, deployment target, and requested access below. Nothing in this plan is applied until you approve it." />
            <StackPanel>
              <Border Style="{StaticResource SetupCardStyle}" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Organization" Foreground="#087D73" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock x:Name="ReviewOrganization" FontWeight="SemiBold" FontSize="18" Margin="0,7,0,0" TextWrapping="Wrap" />
                  <TextBlock x:Name="ReviewAdministrator" Foreground="#496D68" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SetupCardStyle}" Padding="20">
                <StackPanel>
                  <TextBlock Text="Deployment target" Foreground="#087D73" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock x:Name="ReviewBrowsers" FontWeight="SemiBold" FontSize="18" Margin="0,7,0,0" />
                  <TextBlock x:Name="ReviewGroup" Foreground="#496D68" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
            <Border Style="{StaticResource SetupCardStyle}" Padding="20" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="Administrator-approved access" Foreground="#087D73" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="ReviewPermissions" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="21" />
                <Expander Header="Technical plan details" Margin="0,14,0,0" Foreground="#496D68">
                  <TextBlock x:Name="ReviewTechnical" Margin="0,10,0,0" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                </Expander>
              </StackPanel>
            </Border>
            <Border x:Name="PreviewAcknowledgementPanel" Margin="0,16,0,0" Background="White" BorderBrush="#2B8C83" BorderThickness="1.5" CornerRadius="10" Padding="16">
              <CheckBox x:Name="ReviewAcknowledgement" Checked="ReviewAcknowledgement_Changed" Unchecked="ReviewAcknowledgement_Changed">
                <TextBlock TextWrapping="Wrap" Text="I understand this is a synthetic preview. Clicking the next button will demonstrate progress and a receipt without contacting Microsoft or changing any organization resource." />
              </CheckBox>
            </Border>
            <Border x:Name="FinalWriteAcknowledgementPanel" Visibility="Collapsed" Margin="0,16,0,0" Background="#F2FAF8" BorderBrush="#087D73" BorderThickness="2" CornerRadius="12" Padding="18">
              <StackPanel>
                <TextBlock Text="Final administrator approval" Foreground="#087D73" FontWeight="SemiBold" FontSize="15" />
                <CheckBox x:Name="FinalWriteAcknowledgement" Margin="0,10,0,4"
                          Checked="FinalWriteAcknowledgement_Changed" Unchecked="FinalWriteAcknowledgement_Changed">
                  <TextBlock TextWrapping="Wrap" Text="I reviewed this plan and authorize creation or reconciliation of this customer-owned Entra application registration." />
                </CheckBox>
                <TextBlock TextWrapping="Wrap" Foreground="#496D68" FontSize="12"
                           Text="Automatic setup temporarily grants Application.ReadWrite.All. After the exact application is verified, Better CaptionKeep removes its bootstrap enterprise application and clears its local token cache. Microsoft may still accept the issued access token until its recorded expiry." />
                <Button x:Name="DeployButton" Visibility="Collapsed" Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,16,0,0" HorizontalAlignment="Left" Content="Deploy application registration"
                        Click="DeployButton_Click" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
            <TextBlock x:Name="ProgressHeading" Text="Previewing deployment and verification" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Focusable="True" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Margin="0,12,0,24" FontSize="15" TextWrapping="Wrap" Text="This screen demonstrates the customer experience only. No Microsoft, Intune, browser, or endpoint operation is running." />
            <Border x:Name="DeploymentProgressPanel" Style="{StaticResource SetupCardStyle}" Padding="26">
              <StackPanel>
                <TextBlock x:Name="ProgressStepTitle" Text="Preparing preview" FontWeight="SemiBold" FontSize="18" />
                <TextBlock x:Name="ProgressStepDetail" Margin="0,7,0,18" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <TextBlock x:Name="DeploymentProgressText" Visibility="Collapsed" Margin="0,7,0,18" TextWrapping="Wrap"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="DeploymentProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" />
                <TextBlock x:Name="ProgressPercent" Margin="0,10,0,0" HorizontalAlignment="Right" FontWeight="SemiBold" Text="0%" />
              </StackPanel>
            </Border>
            <TextBlock Margin="0,16,0,0" Text="Simulation only · no organization changes" HorizontalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
          </StackPanel>

          <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
            <TextBlock x:Name="ResultHeading" Text="This is what verified setup will look like" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Focusable="True" AutomationProperties.HeadingLevel="Level1" />
            <Border Margin="0,20,0,20" Background="#153B7D45" BorderBrush="#3B7D45" BorderThickness="1" CornerRadius="12" Padding="22">
              <StackPanel>
                <TextBlock Text="✓  Preview completed" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="The final product will only show Setup verified after Microsoft Graph, Intune, and endpoint observations confirm the deployment. This preview made no changes." />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SetupCardStyle}" Padding="22">
              <StackPanel>
                <TextBlock x:Name="ReceiptHeading" Text="Sample deployment receipt" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14" />
                <TextBlock x:Name="ResultSummary" TextWrapping="Wrap" FontSize="14" LineHeight="23" />
                <TextBlock x:Name="ReceiptLabel" Text="Sample receipt ID" FontWeight="SemiBold" Margin="0,16,0,6" />
                <TextBox x:Name="ReceiptPathText" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         AutomationProperties.Name="Deployment receipt path" />
                <Button x:Name="CheckStatusButton" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,16,0,0" HorizontalAlignment="Left" Content="Check setup status"
                        Click="CheckStatusButton_Click" />
                <StackPanel x:Name="DemoResultActions" Orientation="Horizontal" Margin="0,18,0,0">
                  <Button Style="{StaticResource PrimaryButtonStyle}" Content="Run demo again" Click="RunDemoAgainButton_Click" />
                  <Button Style="{StaticResource SecondaryButtonStyle}" Content="Close" Click="CloseResultButton_Click" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="3" Background="White" BorderBrush="#B8CECA" BorderThickness="0,1,0,0" Padding="24,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,18,0"
                   Foreground="#496D68"
                   Text="Ready to begin. No organization changes have been made." AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="CancelButton" Style="{StaticResource SecondaryButtonStyle}" Content="Exit" Click="CancelButton_Click" IsCancel="True" />
          <Button x:Name="ContinueButton" Style="{StaticResource PrimaryButtonStyle}" Content="Get started" Click="ContinueButton_Click" IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>
    </Grid>
  </Border>
</Window>
